{
  "$note": "Kontrasti proverani na pozadini teme. 'muted' i 'danger' su ispravljeni u odnosu na prototip (stare vrednosti nisu prolazile 4.5:1).",
  "themes": {
    "gold": {
      "name": "Ponoć i zlato",
      "default": true,
      "color": {
        "bg": "#0B1B3A",
        "surface": "#12285A",
        "incomingBubble": "#1B3470",
        "onIncoming": "#F1ECE0",
        "outgoingBubble": "#D9A93C",
        "onOutgoing": "#0B1B3A",
        "onBg": "#F1ECE0",
        "muted": "#8C9CC0",
        "accent": "#D9A93C",
        "onAccent": "#0B1B3A",
        "divider": "#2A3E6B",
        "danger": "#FF6B6B",
        "success": "#7BD88F",
        "reactionPill": "#12285A",
        "reactionPillBorder": "#0B1B3A"
      },
      "font": { "family": "system", "weightRegular": 400, "weightStrong": 500 },
      "shape": {
        "bubbleRadiusDp": 18,
        "bubbleTailRadiusDp": 4,
        "avatar": "circle",
        "chip": "pill",
        "card": 12
      }
    },
    "tmux": {
      "name": "Nord tmux",
      "default": false,
      "color": {
        "bg": "#2E3440",
        "surface": "#3B4252",
        "selected": "#434C5E",
        "onBg": "#D8DEE9",
        "muted": "#A9B3CA",
        "accent": "#88C0D0",
        "onAccent": "#2E3440",
        "ownNick": "#A3BE8C",
        "statusBar": "#A3BE8C",
        "onStatusBar": "#2E3440",
        "divider": "#4C566A",
        "danger": "#E58A93",
        "success": "#A3BE8C"
      },
      "font": { "family": "monospace", "weightRegular": 400, "weightStrong": 400 },
      "shape": { "bubbleRadiusDp": 0, "avatar": "none", "chip": "bracket", "card": 0 }
    }
  },
  "typography": {
    "$unit": "sp",
    "screenTitle": { "size": 24, "weight": "strong" },
    "rowName": { "size": 16, "weight": "strong" },
    "rowPreview": { "size": 14, "weight": "regular" },
    "bubble": { "size": 16, "weight": "regular" },
    "meta": { "size": 12, "weight": "regular", "$note": "vreme, status, bedž, oznake" },
    "tmuxBody": { "size": 13, "lineHeight": 1.55 }
  },
  "spacing": { "$unit": "dp", "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 },
  "touch": { "minTargetDp": 48, "rowMinHeightDp": 64, "avatarDp": 48, "tabBarHeightDp": 64 },
  "motion": { "pickerInMs": 150, "bubbleSendMs": 180, "$note": "poštuj sistemsko 'smanji animacije'" }
}
